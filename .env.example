# Copy to .env for local tests only. Never commit a real .env file.
# On Vercel, set the same names under Project Settings → Environment Variables.
# The browser never sees STRIPE_SECRET_KEY.

# Public site origin, no trailing slash. Stripe success and cancel URLs are built from this.
APP_URL=https://frost-co.org

# Stripe Dashboard → Developers → API keys. Use sk_test_... until a test purchase works.
STRIPE_SECRET_KEY=sk_test_REPLACE_ME

# Optional. Stripe Dashboard → Product catalogue → Shipping rates (shr_...).
# Without it, Checkout still collects a shipping address but does not add a shipping fee.
STRIPE_SHIPPING_RATE_ID=

# Optional comma-separated ISO country codes shown in the address form.
# Defaults to EU countries plus GB, NO, CH, US and CA when this is empty.
# STRIPE_SHIPPING_COUNTRIES=IE,NL,DE,FR,BE,GB

# Not read by api/checkout.js. Only needed if you later add a Stripe webhook.
STRIPE_WEBHOOK_SECRET=
