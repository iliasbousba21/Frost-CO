# Set these in Vercel Project Settings → Environment Variables.
# Use TEST keys until a full test payment succeeds.
# Never commit real values. The static site does not read this file.

# Public site origin, no trailing slash. Stripe redirects here after payment or cancel.
APP_URL=https://frost-co.org

# Secret key from Stripe Dashboard → Developers → API keys.
# Required for combined multi-item checkout (api/checkout.js).
STRIPE_SECRET_KEY=sk_test_REPLACE_ME

# Optional. Only needed if you add a webhook endpoint later.
STRIPE_WEBHOOK_SECRET=whsec_REPLACE_ME

# Optional. Shipping Rate id from Stripe Dashboard → Product catalogue → Shipping rates.
# When this is a real shr_ id, Checkout adds that rate. Leave the placeholder to skip it.
STRIPE_SHIPPING_RATE_ID=shr_REPLACE_ME

# Optional. Comma-separated browser origins allowed to call the checkout function.
# Add these when the shop stays on GitHub Pages and the function is hosted elsewhere.
# http://localhost is always allowed.
ALLOWED_ORIGINS=https://frost-co.org,https://www.frost-co.org

# Optional. Comma-separated ISO country codes for the shipping address form.
# Defaults to the EU plus GB, NO and CH when unset.
# STRIPE_SHIPPING_COUNTRIES=NL,BE,DE,FR,GB
